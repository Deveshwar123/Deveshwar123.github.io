{
  "name": "deveshwar-portfolio",
  "private": true,
  "version": "1.0.0",
  "description": "Tradition → Circuit: a static portfolio generated from data/resume.json.",
  "type": "module",
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "check:drift": "node scripts/generate.mjs --check",
    "validate": "node scripts/validate-content.mjs",
    "vendor": "node scripts/build-vendor.mjs",
    "serve": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "test:all": "npm run validate && npm run check:drift && npm test && npm run test:e2e"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "esbuild": "0.28.2",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "lighthouse": "13.5.0",
    "three": "0.186.1"
  }
}
